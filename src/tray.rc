#include <windows.h>
#define ID_PORT 200
#define ID_ROOT 201
#define ID_LISTING 202
#define ID_SAVE 203
#define ID_RESET 204
#define ID_GROUP 205
#define IDD_SETTINGS 300

#ifndef MG_CRINKLER
100 ICON DISCARDABLE "systray.ico"
#endif

IDD_SETTINGS DIALOGEX 200, 200, 200, 112
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_DLGFRAME
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Mongoose settings"
FONT 8, "Tahoma"
BEGIN
  GROUPBOX        " Settings ", ID_GROUP, 5, 5, 190, 75
  LTEXT           "Web root", -1, 10, 20, 45, 15
  EDITTEXT        ID_ROOT, 58, 20, 132, 14, ES_READONLY | ES_AUTOHSCROLL | WS_BORDER
  LTEXT           "Port", -1, 10, 40, 45, 15
  EDITTEXT        ID_PORT, 58, 40, 55, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
  CONTROL         "Enable directory listing", ID_LISTING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 60, 175, 15
  LTEXT           "Mongoose web server", -1, 5, 90, 50, 12, WS_DISABLED
  PUSHBUTTON      "Reset", ID_RESET, 68, 88, 58, 16, WS_TABSTOP
  DEFPUSHBUTTON   "Save Settings", ID_SAVE, 130, 88, 65, 16, WS_TABSTOP
END
